<Window x:Class="VoidLaunch.GameLogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
        Title="Game Log" Width="620" Height="700" MinWidth="480" MinHeight="420"
        AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        WindowStartupLocation="Manual" WindowStyle="None">
    <Window.Resources>
        <SolidColorBrush x:Key="BackgroundBrush" po:Freeze="False" Color="#09090D" />
        <SolidColorBrush x:Key="SidebarBrush" po:Freeze="False" Color="#0D0D13" />
        <SolidColorBrush x:Key="CardBrush" po:Freeze="False" Color="#12121A" />
        <SolidColorBrush x:Key="CardHoverBrush" po:Freeze="False" Color="#181821" />
        <SolidColorBrush x:Key="BorderBrush" po:Freeze="False" Color="#242431" />
        <SolidColorBrush x:Key="TextBrush" po:Freeze="False" Color="#F5F5F7" />
        <SolidColorBrush x:Key="SecondaryBrush" po:Freeze="False" Color="#858592" />
        <SolidColorBrush x:Key="AccentBrush" po:Freeze="False" Color="#8B5CF6" />
        <SolidColorBrush x:Key="AccentTextBrush" po:Freeze="False" Color="#F5F5F7" />
        <SolidColorBrush x:Key="ErrorBrush" po:Freeze="False" Color="#F87171" />
        <SolidColorBrush x:Key="ErrorTextBrush" po:Freeze="False" Color="#09090D" />

        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Width" Value="8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="{TemplateBinding Orientation}">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Background="Transparent" BorderThickness="0" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb MinHeight="40">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="{x:Type Thumb}">
                                            <Border x:Name="ThumbBorder" Margin="1,2" Background="{DynamicResource BorderBrush}" CornerRadius="4" />
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ThumbBorder" Property="Background" Value="{DynamicResource SecondaryBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsDragging" Value="True">
                                                    <Setter TargetName="ThumbBorder" Property="Background" Value="{DynamicResource AccentBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Background="Transparent" BorderThickness="0" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Padding" Value="17,9" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" CornerRadius="8">
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.86" /></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.68" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="{x:Type Button}" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="{DynamicResource CardBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8">
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource CardHoverBrush}" /></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource BorderBrush}" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>

        <Style x:Key="WindowButton" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" CornerRadius="8">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource CardHoverBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="GameLogShell" Background="{DynamicResource BackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1" CornerRadius="16" ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="48" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Border Grid.Row="0" Background="{DynamicResource SidebarBrush}" CornerRadius="15,15,0,0"
                    ClipToBounds="True"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <StackPanel Margin="17,0,0,0" VerticalAlignment="Center" Orientation="Horizontal">
                        <Border Width="25" Height="25" Background="{DynamicResource AccentBrush}" CornerRadius="7">
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11"
                                       FontWeight="Bold" Foreground="{DynamicResource AccentTextBrush}" Text="&gt;_" />
                        </Border>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Text="GAME LOG" />
                            <TextBlock x:Name="DockStatusText" FontSize="10" Foreground="{DynamicResource SecondaryBrush}"
                                       Text="Drag near the launcher to attach" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                        <Button Width="48" Height="48" Click="Minimize_Click" Content="−" FontSize="19"
                                Style="{StaticResource WindowButton}" />
                        <Button Width="48" Height="48" Click="Close_Click" Content="×" FontSize="21"
                                Style="{StaticResource WindowButton}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="18">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <StackPanel Margin="0,0,0,14">
                    <TextBlock x:Name="GameNameText" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
                    <TextBlock x:Name="StatusText" Margin="0,4,0,0" Foreground="{DynamicResource SecondaryBrush}" />
                </StackPanel>
                <Border Grid.Row="1" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="10" ClipToBounds="True">
                    <TextBox x:Name="LogTextBox" IsReadOnly="True" AcceptsReturn="True" AcceptsTab="True"
                             TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                             Background="Transparent" Foreground="{DynamicResource TextBrush}" BorderThickness="0"
                             FontFamily="Consolas" FontSize="13" Padding="13" />
                </Border>
                <StackPanel Grid.Row="2" Margin="0,14,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button MinWidth="94" Height="36" Margin="0,0,8,0" Content="Copy log" Click="Copy_Click"
                            Style="{StaticResource SecondaryButton}" />
                    <Button MinWidth="94" Height="36" Content="Close" Click="Close_Click"
                            Style="{StaticResource PrimaryButton}" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
