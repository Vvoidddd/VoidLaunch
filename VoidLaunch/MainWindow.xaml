<Window
    x:Class="VoidLaunch.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
    Title="VoidLaunch"
    Width="1100"
    Height="700"
    MinWidth="1100"
    MinHeight="700"
    MaxWidth="1100"
    MaxHeight="700"
    AllowsTransparency="True"
    Background="Transparent"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None">

    <Window.Resources>

        <!--  COLORS  -->

        <SolidColorBrush x:Key="BackgroundBrush" po:Freeze="False" Color="#09090D" />
        <SolidColorBrush x:Key="SidebarBrush" po:Freeze="False" Color="#0D0D13" />
        <SolidColorBrush x:Key="CardBrush" po:Freeze="False" Color="#12121A" />
        <SolidColorBrush x:Key="CardHoverBrush" po:Freeze="False" Color="#181821" />
        <SolidColorBrush x:Key="BorderBrush" po:Freeze="False" Color="#242431" />
        <SolidColorBrush x:Key="TextBrush" po:Freeze="False" Color="#F5F5F7" />
        <SolidColorBrush x:Key="SecondaryBrush" po:Freeze="False" Color="#858592" />
        <SolidColorBrush x:Key="AccentBrush" po:Freeze="False" Color="#8B5CF6" />
        <SolidColorBrush x:Key="AccentTextBrush" po:Freeze="False" Color="#F5F5F7" />
        <SolidColorBrush x:Key="ErrorBrush" po:Freeze="False" Color="#F87171" />
        <SolidColorBrush x:Key="ErrorTextBrush" po:Freeze="False" Color="#09090D" />
        <SolidColorBrush x:Key="OverlayBrush" po:Freeze="False" Color="#B309090D" />


        <!--  SIDEBAR  -->

        <Style x:Key="SidebarButton" TargetType="{x:Type Button}">

            <Setter Property="Background" Value="Transparent" />

            <Setter Property="Foreground" Value="{DynamicResource SecondaryBrush}" />

            <Setter Property="BorderThickness" Value="0" />

            <Setter Property="FocusVisualStyle" Value="{x:Null}" />

            <Setter Property="HorizontalContentAlignment" Value="Left" />

            <Setter Property="Padding" Value="14,10" />

            <Setter Property="Margin" Value="10,3" />

            <Setter Property="Cursor" Value="Hand" />

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="{x:Type Button}">

                        <Border
                            x:Name="ButtonBorder"
                            Background="{TemplateBinding Background}"
                            CornerRadius="8">

                            <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">

                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource CardHoverBrush}" />

                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />

                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">

                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource BorderBrush}" />

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!--  PRIMARY  -->

        <Style x:Key="PrimaryButton" TargetType="{x:Type Button}">

            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />

            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />

            <Setter Property="BorderThickness" Value="0" />

            <Setter Property="FocusVisualStyle" Value="{x:Null}" />

            <Setter Property="Padding" Value="17,9" />

            <Setter Property="FontWeight" Value="SemiBold" />

            <Setter Property="Cursor" Value="Hand" />

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="{x:Type Button}">

                        <Border
                            x:Name="PrimaryBorder"
                            Background="{TemplateBinding Background}"
                            CornerRadius="8">

                            <ContentPresenter
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">

                                <Setter TargetName="PrimaryBorder" Property="Opacity" Value="0.86" />

                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">

                                <Setter TargetName="PrimaryBorder" Property="Opacity" Value="0.68" />

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!--  WINDOW BUTTON  -->

        <Style x:Key="WindowButton" TargetType="{x:Type Button}">

            <Setter Property="Background" Value="Transparent" />

            <Setter Property="Foreground" Value="{DynamicResource SecondaryBrush}" />

            <Setter Property="BorderThickness" Value="0" />

            <Setter Property="FocusVisualStyle" Value="{x:Null}" />

            <Setter Property="Cursor" Value="Hand" />

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="{x:Type Button}">

                        <Border x:Name="WindowButtonBorder" Background="{TemplateBinding Background}" CornerRadius="8">

                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">

                                <Setter TargetName="WindowButtonBorder" Property="Background" Value="{DynamicResource CardHoverBrush}" />

                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!--  FAVORITE BUTTON  -->

        <Style x:Key="FavoriteButton" TargetType="{x:Type Button}">

            <Setter Property="Background" Value="Transparent" />

            <Setter Property="BorderThickness" Value="0" />

            <Setter Property="Padding" Value="0" />

            <Setter Property="FocusVisualStyle" Value="{x:Null}" />

            <Setter Property="Cursor" Value="Hand" />

            <Setter Property="HorizontalContentAlignment" Value="Center" />

            <Setter Property="VerticalContentAlignment" Value="Center" />

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="{x:Type Button}">

                        <Border
                            x:Name="FavoriteBorder"
                            Width="34"
                            Height="34"
                            Background="Transparent"
                            CornerRadius="8">

                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">

                                <Setter TargetName="FavoriteBorder" Property="Background" Value="{DynamicResource CardHoverBrush}" />

                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">

                                <Setter TargetName="FavoriteBorder" Property="Background" Value="{DynamicResource BorderBrush}" />

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!--  CUSTOM SCROLLBAR  -->

        <Style x:Key="VoidScrollBar" TargetType="{x:Type ScrollBar}">

            <Setter Property="Width" Value="8" />

            <Setter Property="Background" Value="Transparent" />

            <Setter Property="Foreground" Value="{DynamicResource BorderBrush}" />

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="{x:Type ScrollBar}">

                        <Grid Background="Transparent">

                            <Track x:Name="PART_Track" IsDirectionReversed="true" Orientation="{TemplateBinding Orientation}">

                                <Track.DecreaseRepeatButton>

                                    <RepeatButton
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Command="ScrollBar.PageUpCommand"
                                        Focusable="False"
                                        IsTabStop="False" />

                                </Track.DecreaseRepeatButton>

                                <Track.Thumb>

                                    <Thumb MinHeight="45">

                                        <Thumb.Template>

                                            <ControlTemplate TargetType="{x:Type Thumb}">

                                                <Border
                                                    x:Name="ThumbBorder"
                                                    Margin="1,2,1,2"
                                                    Background="{DynamicResource BorderBrush}"
                                                    CornerRadius="4" />

                                                <ControlTemplate.Triggers>

                                                    <Trigger Property="IsMouseOver" Value="True">

                                                        <Setter TargetName="ThumbBorder" Property="Background" Value="{DynamicResource SecondaryBrush}" />

                                                    </Trigger>

                                                    <Trigger Property="IsDragging" Value="True">

                                                        <Setter TargetName="ThumbBorder" Property="Background" Value="{DynamicResource AccentBrush}" />

                                                    </Trigger>

                                                </ControlTemplate.Triggers>

                                            </ControlTemplate>

                                        </Thumb.Template>

                                    </Thumb>

                                </Track.Thumb>

                                <Track.IncreaseRepeatButton>

                                    <RepeatButton
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Command="ScrollBar.PageDownCommand"
                                        Focusable="False"
                                        IsTabStop="False" />

                                </Track.IncreaseRepeatButton>

                            </Track>

                        </Grid>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!--  TEXTBOX  -->

        <Style TargetType="{x:Type TextBox}">

            <Setter Property="FocusVisualStyle" Value="{x:Null}" />

        </Style>

        <Style x:Key="SecondaryButton" TargetType="{x:Type Button}" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="{DynamicResource CardBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="SecondaryBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SecondaryBorder" Property="Background" Value="{DynamicResource CardHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="SecondaryBorder" Property="Opacity" Value="0.72" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FieldTextBox" TargetType="{x:Type TextBox}">
            <Setter Property="Background" Value="{DynamicResource CardBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TextBox}">
                        <Border x:Name="FieldBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FieldBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InfoCard" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="{DynamicResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="18" />
        </Style>

        <Style x:Key="VoidProgressBar" TargetType="{x:Type ProgressBar}">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Background" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ProgressBar}">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" ClipToBounds="True">
                            <Grid x:Name="PART_Track" ClipToBounds="True">
                                <Border x:Name="PART_Indicator" HorizontalAlignment="Left"
                                        Background="{TemplateBinding Foreground}" CornerRadius="4" />
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Use VoidLaunch chrome for every scrollbar in this window, including text editors. -->
        <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource VoidScrollBar}" />

    </Window.Resources>

    <Grid>

    <Border
        x:Name="MainWindowShell"
        Background="{DynamicResource BackgroundBrush}"
        BorderBrush="{DynamicResource BorderBrush}"
        BorderThickness="1"
        CornerRadius="16"
        ClipToBounds="True">

        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>


            <!--  TITLE BAR  -->

            <Border
                Grid.Row="0"
                Background="{DynamicResource SidebarBrush}"
                CornerRadius="15,15,0,0"
                ClipToBounds="True"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">

                <Grid>

                    <StackPanel
                        Margin="17,0,0,0"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">

                        <Border
                            Width="25"
                            Height="25"
                            Background="{DynamicResource AccentBrush}"
                            CornerRadius="7">

                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="13"
                                FontWeight="Bold"
                                Foreground="{DynamicResource AccentTextBrush}"
                                Text="V" />

                        </Border>

                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center" Orientation="Horizontal">
                            <TextBlock FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextBrush}" Text="VOID" />
                            <TextBlock FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentBrush}" Text="LAUNCH" />
                        </StackPanel>

                    </StackPanel>

                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">

                        <Button
                            Width="48"
                            Height="48"
                            Click="Minimize_Click"
                            Content="−"
                            FontSize="19"
                            Style="{StaticResource WindowButton}" />

                        <Button
                            Width="48"
                            Height="48"
                            Click="Close_Click"
                            Content="×"
                            FontSize="21"
                            Style="{StaticResource WindowButton}" />

                    </StackPanel>

                </Grid>

            </Border>


            <!--  BODY  -->

            <Grid Grid.Row="1">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="210" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>


                <!--  SIDEBAR  -->

                <Border
                    Grid.Column="0"
                    Background="{DynamicResource SidebarBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,1,0"
                    CornerRadius="0,0,0,15"
                    ClipToBounds="True">

                    <Grid>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="105" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="55" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="24,22,0,0">

                            <TextBlock
                                FontSize="25"
                                FontWeight="Bold"
                                Foreground="{DynamicResource TextBrush}"
                                Text="VOID" />

                            <TextBlock
                                FontSize="10"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource AccentBrush}"
                                Text="LAUNCH" />

                        </StackPanel>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,8,0,8">

                            <TextBlock
                                Margin="25,0,0,8"
                                FontSize="10"
                                FontWeight="Bold"
                                Foreground="{DynamicResource SecondaryBrush}"
                                Text="LIBRARY" />

                            <Button Click="AllGames_Click" Style="{StaticResource SidebarButton}">

                                <StackPanel Orientation="Horizontal">

                                    <TextBlock
                                        Width="28"
                                        FontSize="17"
                                        Text="▦" />

                                    <TextBlock VerticalAlignment="Center" Text="All Games" />

                                </StackPanel>

                            </Button>

                            <Button Click="Favorites_Click" Style="{StaticResource SidebarButton}">

                                <StackPanel Orientation="Horizontal">

                                    <TextBlock
                                        Width="28"
                                        FontSize="16"
                                        Text="★" />

                                    <TextBlock VerticalAlignment="Center" Text="Favorites" />

                                </StackPanel>

                            </Button>

                            <Button Click="Recent_Click" Style="{StaticResource SidebarButton}">

                                <StackPanel Orientation="Horizontal">

                                    <TextBlock
                                        Width="28"
                                        FontSize="16"
                                        Text="◷" />

                                    <TextBlock VerticalAlignment="Center" Text="Recently Played" />

                                </StackPanel>

                            </Button>

                            <TextBlock
                                Margin="25,27,0,8"
                                FontSize="10"
                                FontWeight="Bold"
                                Foreground="{DynamicResource SecondaryBrush}"
                                Text="LOCATIONS" />

                            <Button Click="AddFolder_Click" Style="{StaticResource SidebarButton}">

                                <StackPanel Orientation="Horizontal">

                                    <TextBlock
                                        Width="28"
                                        FontSize="19"
                                        Foreground="{DynamicResource AccentBrush}"
                                        Text="+" />

                                    <TextBlock VerticalAlignment="Center" Text="Add Game Folder" />

                                </StackPanel>

                            </Button>

                            <Button Click="ScanReview_Click" Style="{StaticResource SidebarButton}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Width="28" FontSize="16" Text="✓" />
                                        <TextBlock VerticalAlignment="Center" Text="Scan Review" />
                                    </StackPanel>
                                    <Border x:Name="ScanReviewCountBadge" Grid.Column="1" MinWidth="22" Height="22"
                                            Padding="5,0" VerticalAlignment="Center"
                                            Background="{DynamicResource AccentBrush}" CornerRadius="8"
                                            Visibility="Collapsed">
                                        <TextBlock x:Name="ScanReviewCountText" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   FontSize="10" FontWeight="Bold"
                                                   Foreground="{DynamicResource AccentTextBrush}" />
                                    </Border>
                                </Grid>
                            </Button>

                            <TextBlock Margin="25,27,0,8" FontSize="10" FontWeight="Bold"
                                       Foreground="{DynamicResource SecondaryBrush}" Text="CUSTOMIZE" />

                            <Button Click="Settings_Click" Style="{StaticResource SidebarButton}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Width="28" FontSize="16" Text="⚙" />
                                    <TextBlock VerticalAlignment="Center" Text="Theme Studio" />
                                </StackPanel>
                            </Button>

                            <TextBlock Margin="25,24,0,8" FontSize="10" FontWeight="Bold"
                                       Foreground="{DynamicResource SecondaryBrush}" Text="INFORMATION" />

                            <Button Click="Versions_Click" Style="{StaticResource SidebarButton}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Width="28" FontSize="16" Text="↺" />
                                    <TextBlock VerticalAlignment="Center" Text="Versions" />
                                </StackPanel>
                            </Button>

                            <Button Click="ComingSoon_Click" Style="{StaticResource SidebarButton}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Width="28" FontSize="16" Text="◇" />
                                    <TextBlock VerticalAlignment="Center" Text="Coming Soon" />
                                </StackPanel>
                            </Button>

                            <Button Click="Developer_Click" Style="{StaticResource SidebarButton}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Width="28" FontSize="16" Text="&lt;/&gt;" />
                                    <TextBlock VerticalAlignment="Center" Text="Developer" />
                                </StackPanel>
                            </Button>

                            <Button Click="About_Click" Style="{StaticResource SidebarButton}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Width="28" FontSize="16" Text="ⓘ" />
                                    <TextBlock VerticalAlignment="Center" Text="About &amp; Health" />
                                </StackPanel>
                            </Button>

                            <Button Click="Privacy_Click" Style="{StaticResource SidebarButton}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Width="28" FontSize="16" Text="◈" />
                                    <TextBlock VerticalAlignment="Center" Text="Privacy" />
                                </StackPanel>
                            </Button>

                        </StackPanel>
                        </ScrollViewer>

                        <TextBlock
                            Grid.Row="2"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="10"
                            Foreground="{DynamicResource SecondaryBrush}"
                            Text="VOIDLAUNCH" />

                    </Grid>

                </Border>


                <!--  MAIN  -->

                <Grid x:Name="LibraryPage" Grid.Column="1" Margin="28">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="55" />
                        <RowDefinition Height="70" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>


                    <!--  HEADER  -->

                    <Grid Grid.Row="0">

                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="25"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource TextBrush}"
                            Text="Library" />

                        <Border
                            Width="245"
                            Height="36"
                            HorizontalAlignment="Right"
                            Background="{DynamicResource CardBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8">

                            <Grid>

                                <TextBlock
                                    Margin="12,0,0,0"
                                    VerticalAlignment="Center"
                                    FontSize="17"
                                    Foreground="{DynamicResource SecondaryBrush}"
                                    Text="⌕" />

                                <TextBox
                                    x:Name="SearchBox"
                                    Margin="36,0,10,0"
                                    VerticalContentAlignment="Center"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    FontSize="13"
                                    Foreground="{DynamicResource TextBrush}"
                                    TextChanged="SearchBox_TextChanged" />

                            </Grid>

                        </Border>

                    </Grid>


                    <!--  INFO  -->

                    <Grid Grid.Row="1" Margin="0,8,0,8">

                        <StackPanel VerticalAlignment="Center">

                            <TextBlock
                                x:Name="GameCountText"
                                FontSize="18"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource TextBrush}"
                                Text="0 Games" />

                            <TextBlock
                                x:Name="GameFolderText"
                                Margin="0,4,0,0"
                                FontSize="12"
                                Foreground="{DynamicResource SecondaryBrush}"
                                Text="No game folders configured" />

                        </StackPanel>

                        <WrapPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button x:Name="SortLibraryButton" Margin="0,0,7,0" Click="SortLibrary_Click"
                                    Content="Sort: Name" Style="{StaticResource SecondaryButton}" />
                            <Button x:Name="ViewModeButton" Margin="0,0,7,0" Click="ToggleLibraryView_Click"
                                    Content="Compact view" Style="{StaticResource SecondaryButton}" />
                            <Button x:Name="RefreshScanButton" Margin="0,0,7,0" Click="RefreshScan_Click"
                                    Content="Refresh library" Style="{StaticResource SecondaryButton}" />
                            <Button Click="AddFolder_Click" Content="+ Add Folder"
                                    Style="{StaticResource PrimaryButton}" />
                        </WrapPanel>

                        <ProgressBar x:Name="LibraryScanProgressBar" Height="5" Margin="0,61,0,0"
                                     HorizontalAlignment="Stretch" VerticalAlignment="Top"
                                     Minimum="0" Maximum="100" Visibility="Collapsed"
                                     Style="{StaticResource VoidProgressBar}" />

                    </Grid>


                    <!--  GAMES  -->

                    <ScrollViewer
                        Grid.Row="2"
                        Padding="0,0,3,0"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">

                        <ScrollViewer.Resources>

                            <Style BasedOn="{StaticResource VoidScrollBar}" TargetType="{x:Type ScrollBar}" />

                        </ScrollViewer.Resources>

                        <UniformGrid
                            x:Name="GameLibrary"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Columns="3" />

                    </ScrollViewer>

                </Grid>

                <!-- GAME DETAILS -->
                <Grid x:Name="GameDetailsPage" Grid.Column="1" Margin="28" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="55" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Button HorizontalAlignment="Left" Content="←  Library" Click="BackToLibrary_Click"
                                Style="{StaticResource SecondaryButton}" />
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="25"
                                   FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Text="Game Details" />
                    </Grid>

                    <Border Grid.Row="1" Margin="0,8,0,0" Style="{StaticResource InfoCard}" />
                    <ScrollViewer Grid.Row="1" Margin="18,18,18,18" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock x:Name="DetailsGameName" FontSize="28" FontWeight="Bold"
                                       Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Margin="0,7,0,16" Foreground="{DynamicResource SecondaryBrush}"
                                       Text="Choose exactly which executable VoidLaunch starts for this game." />

                            <UniformGrid Margin="0,0,0,22" Columns="3">
                                <Border Margin="0,0,8,0" Padding="13,11" Background="{DynamicResource CardHoverBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10">
                                    <StackPanel>
                                        <TextBlock FontSize="10" FontWeight="Bold" Foreground="{DynamicResource SecondaryBrush}"
                                                   Text="TOTAL PLAYTIME" />
                                        <TextBlock x:Name="DetailsPlayTimeText" Margin="0,6,0,0" FontSize="16"
                                                   FontWeight="SemiBold" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextBrush}" Text="Not played yet" />
                                    </StackPanel>
                                </Border>
                                <Border Margin="0,0,8,0" Padding="13,11" Background="{DynamicResource CardHoverBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10">
                                    <StackPanel>
                                        <TextBlock FontSize="10" FontWeight="Bold" Foreground="{DynamicResource SecondaryBrush}"
                                                   Text="TIMES LAUNCHED" />
