<Window
    x:Class="VoidLaunch.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
    Title="VoidLaunch"
    Width="1100"
    Height="700"
    MinWidth="1100"
    MinHeight="700"
    MaxWidth="1100"
    MaxHeight="700"
    AllowsTransparency="True"
    Background="Transparent"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None">

    <Window.Resources>

        <!--  COLORS  -->

        <SolidColorBrush x:Key="BackgroundBrush" po:Freeze="False" Color="#09090D" />
        <SolidColorBrush x:Key="SidebarBrush" po:Freeze="False" Color="#0D0D13" />
        <SolidColorBrush x:Key="CardBrush" po:Freeze="False" Color="#12121A" />
        <SolidColorBrush x:Key="CardHoverBrush" po:Freeze="False" Color="#181821" />
        <SolidColorBrush x:Key="BorderBrush" po:Freeze="False" Color="#242431" />
        <SolidColorBrush x:Key="TextBrush" po:Freeze="False" Color="#F5F5F7" />
        <SolidColorBrush x:Key="SecondaryBrush" po:Freeze="False" Color="#858592" />
        <SolidColorBrush x:Key="AccentBrush" po:Freeze="False" Color="#8B5CF6" />
        <SolidColorBrush x:Key="ErrorBrush" po:Freeze="False" Color="#F87171" />


        <!--  SIDEBAR  -->

        <Style x:Key="SidebarButton" TargetType="{x:Type Button}">

            <Setter Property="Background" Value="Transparent" />

            <Setter Property="Foreground" Value="{StaticResource SecondaryBrush}" />

            <Setter Property="BorderThickness" Value="0" />

            <Setter Property="FocusVisualStyle" Value="{x:Null}" />

            <Setter Property="HorizontalContentAlignment" Value="Left" />

            <Setter Property="Padding" Value="14,10" />

            <Setter Property="Margin" Value="10,3" />

            <Setter Property="Cursor" Value="Hand" />

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="{x:Type Button}">

                        <Border
                            x:Name="ButtonBorder"
                            Background="{TemplateBinding Background}"
                            CornerRadius="8">

                            <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">

                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource CardHoverBrush}" />

                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />

                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">

                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource BorderBrush}" />

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!--  PRIMARY  -->

        <Style x:Key="PrimaryButton" TargetType="{x:Type Button}">

            <Setter Property="Background" Value="{StaticResource AccentBrush}" />

            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />

            <Setter Property="BorderThickness" Value="0" />

            <Setter Property="FocusVisualStyle" Value="{x:Null}" />

            <Setter Property="Padding" Value="17,9" />

            <Setter Property="FontWeight" Value="SemiBold" />

            <Setter Property="Cursor" Value="Hand" />

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="{x:Type Button}">

                        <Border
                            x:Name="PrimaryBorder"
                            Background="{TemplateBinding Background}"
                            CornerRadius="8">

                            <ContentPresenter
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">

                                <Setter TargetName="PrimaryBorder" Property="Opacity" Value="0.86" />

                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">

                                <Setter TargetName="PrimaryBorder" Property="Opacity" Value="0.68" />

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!--  WINDOW BUTTON  -->

        <Style x:Key="WindowButton" TargetType="{x:Type Button}">

            <Setter Property="Background" Value="Transparent" />

            <Setter Property="Foreground" Value="{StaticResource SecondaryBrush}" />

            <Setter Property="BorderThickness" Value="0" />

            <Setter Property="FocusVisualStyle" Value="{x:Null}" />

            <Setter Property="Cursor" Value="Hand" />

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="{x:Type Button}">

                        <Border x:Name="WindowButtonBorder" Background="{TemplateBinding Background}">

                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">

                                <Setter TargetName="WindowButtonBorder" Property="Background" Value="{StaticResource CardHoverBrush}" />

                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!--  FAVORITE BUTTON  -->

        <Style x:Key="FavoriteButton" TargetType="{x:Type Button}">

            <Setter Property="Background" Value="Transparent" />

            <Setter Property="BorderThickness" Value="0" />

            <Setter Property="Padding" Value="0" />

            <Setter Property="FocusVisualStyle" Value="{x:Null}" />

            <Setter Property="Cursor" Value="Hand" />

            <Setter Property="HorizontalContentAlignment" Value="Center" />

            <Setter Property="VerticalContentAlignment" Value="Center" />

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="{x:Type Button}">

                        <Border
                            x:Name="FavoriteBorder"
                            Width="34"
                            Height="34"
                            Background="Transparent"
                            CornerRadius="8">

                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">

                                <Setter TargetName="FavoriteBorder" Property="Background" Value="{StaticResource CardHoverBrush}" />

                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">

                                <Setter TargetName="FavoriteBorder" Property="Background" Value="{StaticResource BorderBrush}" />

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!--  CUSTOM SCROLLBAR  -->

        <Style x:Key="VoidScrollBar" TargetType="{x:Type ScrollBar}">

            <Setter Property="Width" Value="8" />

            <Setter Property="Background" Value="Transparent" />

            <Setter Property="Foreground" Value="{StaticResource BorderBrush}" />

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="{x:Type ScrollBar}">

                        <Grid Background="Transparent">

                            <Track x:Name="PART_Track" IsDirectionReversed="true" Orientation="{TemplateBinding Orientation}">

                                <Track.DecreaseRepeatButton>

                                    <RepeatButton
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Command="ScrollBar.PageUpCommand"
                                        Focusable="False"
                                        IsTabStop="False" />

                                </Track.DecreaseRepeatButton>

                                <Track.Thumb>

                                    <Thumb MinHeight="45">

                                        <Thumb.Template>

                                            <ControlTemplate TargetType="{x:Type Thumb}">

                                                <Border
                                                    x:Name="ThumbBorder"
                                                    Margin="1,2,1,2"
                                                    Background="{StaticResource BorderBrush}"
                                                    CornerRadius="4" />

                                                <ControlTemplate.Triggers>

                                                    <Trigger Property="IsMouseOver" Value="True">

                                                        <Setter TargetName="ThumbBorder" Property="Background" Value="{StaticResource SecondaryBrush}" />

                                                    </Trigger>

                                                    <Trigger Property="IsDragging" Value="True">

                                                        <Setter TargetName="ThumbBorder" Property="Background" Value="{StaticResource AccentBrush}" />

                                                    </Trigger>

                                                </ControlTemplate.Triggers>

                                            </ControlTemplate>

                                        </Thumb.Template>

                                    </Thumb>

                                </Track.Thumb>

                                <Track.IncreaseRepeatButton>

                                    <RepeatButton
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Command="ScrollBar.PageDownCommand"
                                        Focusable="False"
                                        IsTabStop="False" />

                                </Track.IncreaseRepeatButton>

                            </Track>

                        </Grid>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!--  TEXTBOX  -->

        <Style TargetType="{x:Type TextBox}">

            <Setter Property="FocusVisualStyle" Value="{x:Null}" />

        </Style>

        <Style x:Key="SecondaryButton" TargetType="{x:Type Button}" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="{StaticResource CardBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="SecondaryBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SecondaryBorder" Property="Background" Value="{StaticResource CardHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="SecondaryBorder" Property="Opacity" Value="0.72" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FieldTextBox" TargetType="{x:Type TextBox}">
            <Setter Property="Background" Value="{StaticResource CardBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TextBox}">
                        <Border x:Name="FieldBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FieldBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InfoCard" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="{StaticResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="18" />
        </Style>

        <Style x:Key="VoidProgressBar" TargetType="{x:Type ProgressBar}">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Background" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ProgressBar}">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" ClipToBounds="True">
                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left"
                                    Background="{TemplateBinding Foreground}" CornerRadius="4" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Use VoidLaunch chrome for every scrollbar in this window, including text editors. -->
        <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource VoidScrollBar}" />

    </Window.Resources>


    <Border
        Background="{StaticResource BackgroundBrush}"
        BorderBrush="{StaticResource BorderBrush}"
        BorderThickness="1"
        CornerRadius="10"
        ClipToBounds="True">

        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>


            <!--  TITLE BAR  -->

            <Border
                Grid.Row="0"
                Background="{StaticResource SidebarBrush}"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">

                <Grid>

                    <StackPanel
                        Margin="17,0,0,0"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">

                        <Border
                            Width="25"
                            Height="25"
                            Background="{StaticResource AccentBrush}"
                            CornerRadius="7">

                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="13"
                                FontWeight="Bold"
                                Foreground="{StaticResource TextBrush}"
                                Text="V" />

                        </Border>

                        <TextBlock
                            Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource TextBrush}"
                            Text="VOIDLAUNCH" />

                    </StackPanel>

                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">

                        <Button
                            Width="48"
                            Height="48"
                            Click="Minimize_Click"
                            Content="−"
                            FontSize="19"
                            Style="{StaticResource WindowButton}" />

                        <Button
                            Width="48"
                            Height="48"
                            Click="Close_Click"
                            Content="×"
                            FontSize="21"
                            Style="{StaticResource WindowButton}" />

                    </StackPanel>

                </Grid>

            </Border>


            <!--  BODY  -->

            <Grid Grid.Row="1">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="210" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>


                <!--  SIDEBAR  -->

                <Border
                    Grid.Column="0"
                    Background="{StaticResource SidebarBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,1,0">

                    <Grid>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="105" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="55" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="24,22,0,0">

                            <TextBlock
                                FontSize="25"
                                FontWeight="Bold"
                                Foreground="{StaticResource TextBrush}"
                                Text="VOID" />

                            <TextBlock
                                FontSize="10"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource AccentBrush}"
                                Text="LAUNCH" />

                        </StackPanel>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,8,0,8">

                            <TextBlock
                                Margin="25,0,0,8"
                                FontSize="10"
                                FontWeight="Bold"
                                Foreground="{StaticResource SecondaryBrush}"
                                Text="LIBRARY" />

                            <Button Click="AllGames_Click" Style="{StaticResource SidebarButton}">

                                <StackPanel Orientation="Horizontal">

                                    <TextBlock
                                        Width="28"
                                        FontSize="17"
                                        Text="▦" />

                                    <TextBlock VerticalAlignment="Center" Text="All Games" />

                                </StackPanel>

                            </Button>

                            <Button Click="Favorites_Click" Style="{StaticResource SidebarButton}">

                                <StackPanel Orientation="Horizontal">

                                    <TextBlock
                                        Width="28"
                                        FontSize="16"
                                        Text="★" />

                                    <TextBlock VerticalAlignment="Center" Text="Favorites" />

                                </StackPanel>

                            </Button>

                            <Button Click="Recent_Click" Style="{StaticResource SidebarButton}">

                                <StackPanel Orientation="Horizontal">

                                    <TextBlock
                                        Width="28"
                                        FontSize="16"
                                        Text="◷" />

                                    <TextBlock VerticalAlignment="Center" Text="Recently Played" />

                                </StackPanel>

                            </Button>

                            <TextBlock
                                Margin="25,27,0,8"
                                FontSize="10"
                                FontWeight="Bold"
                                Foreground="{StaticResource SecondaryBrush}"
                                Text="LOCATIONS" />

                            <Button Click="AddFolder_Click" Style="{StaticResource SidebarButton}">

                                <StackPanel Orientation="Horizontal">

                                    <TextBlock
                                        Width="28"
                                        FontSize="19"
                                        Foreground="{StaticResource AccentBrush}"
                                        Text="+" />

                                    <TextBlock VerticalAlignment="Center" Text="Add Game Folder" />

                                </StackPanel>

                            </Button>

                            <TextBlock Margin="25,27,0,8" FontSize="10" FontWeight="Bold"
                                       Foreground="{StaticResource SecondaryBrush}" Text="CUSTOMIZE" />

                            <Button Click="Settings_Click" Style="{StaticResource SidebarButton}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Width="28" FontSize="16" Text="⚙" />
                                    <TextBlock VerticalAlignment="Center" Text="Settings &amp; Themes" />
                                </StackPanel>
                            </Button>

                            <TextBlock Margin="25,24,0,8" FontSize="10" FontWeight="Bold"
                                       Foreground="{StaticResource SecondaryBrush}" Text="INFORMATION" />

                            <Button Click="Developer_Click" Style="{StaticResource SidebarButton}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Width="28" FontSize="16" Text="&lt;/&gt;" />
                                    <TextBlock VerticalAlignment="Center" Text="Developer" />
                                </StackPanel>
                            </Button>

                            <Button Click="About_Click" Style="{StaticResource SidebarButton}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Width="28" FontSize="16" Text="ⓘ" />
                                    <TextBlock VerticalAlignment="Center" Text="About &amp; Health" />
                                </StackPanel>
                            </Button>

                            <Button Click="Privacy_Click" Style="{StaticResource SidebarButton}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Width="28" FontSize="16" Text="◈" />
                                    <TextBlock VerticalAlignment="Center" Text="Privacy" />
                                </StackPanel>
                            </Button>

                        </StackPanel>
                        </ScrollViewer>

                        <TextBlock
                            Grid.Row="2"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="10"
                            Foreground="{StaticResource SecondaryBrush}"
                            Text="VOIDLAUNCH" />

                    </Grid>

                </Border>


                <!--  MAIN  -->

                <Grid x:Name="LibraryPage" Grid.Column="1" Margin="28">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="55" />
                        <RowDefinition Height="70" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>


                    <!--  HEADER  -->

                    <Grid Grid.Row="0">

                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="25"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource TextBrush}"
                            Text="Library" />

                        <Border
                            Width="245"
                            Height="36"
                            HorizontalAlignment="Right"
                            Background="{StaticResource CardBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8">

                            <Grid>

                                <TextBlock
                                    Margin="12,0,0,0"
                                    VerticalAlignment="Center"
                                    FontSize="17"
                                    Foreground="{StaticResource SecondaryBrush}"
                                    Text="⌕" />

                                <TextBox
                                    x:Name="SearchBox"
                                    Margin="36,0,10,0"
                                    VerticalContentAlignment="Center"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    FontSize="13"
                                    Foreground="{StaticResource TextBrush}"
                                    TextChanged="SearchBox_TextChanged" />

                            </Grid>

                        </Border>

                    </Grid>


                    <!--  INFO  -->

                    <Grid Grid.Row="1" Margin="0,8,0,8">

                        <StackPanel VerticalAlignment="Center">

                            <TextBlock
                                x:Name="GameCountText"
                                FontSize="18"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource TextBrush}"
                                Text="0 Games" />

                            <TextBlock
                                x:Name="GameFolderText"
                                Margin="0,4,0,0"
                                FontSize="12"
                                Foreground="{StaticResource SecondaryBrush}"
                                Text="No game folders configured" />

                        </StackPanel>

                        <Button
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Click="AddFolder_Click"
                            Content="+ Add Folder"
                            Style="{StaticResource PrimaryButton}" />

                    </Grid>


                    <!--  GAMES  -->

                    <ScrollViewer
                        Grid.Row="2"
                        Padding="0,0,3,0"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">

                        <ScrollViewer.Resources>

                            <Style BasedOn="{StaticResource VoidScrollBar}" TargetType="{x:Type ScrollBar}" />

                        </ScrollViewer.Resources>

                        <UniformGrid
                            x:Name="GameLibrary"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Columns="3" />

                    </ScrollViewer>

                </Grid>

                <!-- GAME DETAILS -->
                <Grid x:Name="GameDetailsPage" Grid.Column="1" Margin="28" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="55" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Button HorizontalAlignment="Left" Content="←  Library" Click="BackToLibrary_Click"
                                Style="{StaticResource SecondaryButton}" />
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="25"
                                   FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Text="Game Details" />
                    </Grid>

                    <Border Grid.Row="1" Margin="0,8,0,0" Style="{StaticResource InfoCard}" />
                    <ScrollViewer Grid.Row="1" Margin="18,18,18,18" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock x:Name="DetailsGameName" FontSize="28" FontWeight="Bold"
                                       Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Margin="0,7,0,24" Foreground="{StaticResource SecondaryBrush}"
                                       Text="Choose exactly which executable VoidLaunch starts for this game." />

                            <TextBlock FontSize="11" FontWeight="Bold" Foreground="{StaticResource SecondaryBrush}" Text="DISPLAY NAME" />
                            <TextBox x:Name="DetailsNameBox" Margin="0,7,0,18" Style="{StaticResource FieldTextBox}" />

                            <TextBlock FontSize="11" FontWeight="Bold" Foreground="{StaticResource SecondaryBrush}" Text="SELECTED EXECUTABLE" />
                            <TextBox x:Name="DetailsExecutableBox" Margin="0,7,0,10" IsReadOnly="True"
                                     Style="{StaticResource FieldTextBox}" />
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,22">
                                <Button Content="Choose executable…" Click="ChooseExecutable_Click"
                                        Style="{StaticResource PrimaryButton}" />
                                <Button Margin="9,0,0,0" Content="Open install folder" Click="OpenInstallFolder_Click"
                                        Style="{StaticResource SecondaryButton}" />
                            </StackPanel>

                            <TextBlock FontSize="11" FontWeight="Bold" Foreground="{StaticResource SecondaryBrush}"
                                       Text="EXECUTABLES FOUND IN THIS GAME" />
                            <StackPanel x:Name="ExecutableChoices" Margin="0,7,0,22" />

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Save changes" Click="SaveGameDetails_Click"
                                        Style="{StaticResource SecondaryButton}" />
                                <Button Margin="9,0,0,0" Content="▶  Play selected" Click="PlaySelectedGame_Click"
                                        Style="{StaticResource PrimaryButton}" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- SETTINGS / THEME CODE -->
                <Grid x:Name="SettingsPage" Grid.Column="1" Margin="28" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="55" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Button HorizontalAlignment="Left" Content="←  Library" Click="BackToLibrary_Click"
                                Style="{StaticResource SecondaryButton}" />
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="25"
                                   FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Text="Settings" />
                    </Grid>

                    <Border Grid.Row="1" Margin="0,8,0,0" Style="{StaticResource InfoCard}" />
                    <ScrollViewer Grid.Row="1" Margin="18,18,18,18" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock FontSize="19" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"
                                       Text="Premade themes" />
                            <TextBlock Margin="0,5,0,12" Foreground="{StaticResource SecondaryBrush}"
                                       Text="Pick a starting point, then edit its color code below." />
                            <WrapPanel x:Name="ThemeButtons" Margin="0,0,0,25" />

                            <TextBlock FontSize="19" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"
                                       Text="Theme code" />
                            <TextBlock Margin="0,5,0,10" Foreground="{StaticResource SecondaryBrush}"
                                       Text="Change any #RRGGBB value. Unknown keys and invalid colors are rejected safely." />
                            <TextBox x:Name="ThemeCodeBox" Height="260" AcceptsReturn="True" AcceptsTab="True"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                     TextWrapping="Wrap" FontFamily="Consolas" FontSize="13"
                                     Style="{StaticResource FieldTextBox}" />
                            <TextBlock x:Name="ThemeStatusText" Margin="0,8,0,12"
                                       Foreground="{StaticResource SecondaryBrush}" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Reset default" Click="ResetTheme_Click"
                                        Style="{StaticResource SecondaryButton}" />
                                <Button Margin="9,0,0,0" Content="Apply theme code" Click="ApplyTheme_Click"
                                        Style="{StaticResource PrimaryButton}" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- DEVELOPER -->
                <Grid x:Name="DeveloperPage" Grid.Column="1" Margin="28" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="55" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Button HorizontalAlignment="Left" Content="←  Library" Click="BackToLibrary_Click"
                                Style="{StaticResource SecondaryButton}" />
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="25"
                                   FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Text="Developer" />
                    </Grid>
                    <Border Grid.Row="1" Margin="0,8,0,0" Style="{StaticResource InfoCard}">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="520">
                            <Border Width="76" Height="76" Background="{StaticResource AccentBrush}" CornerRadius="22">
                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="22"
                                           FontWeight="Bold" Foreground="{StaticResource TextBrush}" Text="&lt;/&gt;" />
                            </Border>
                            <TextBlock Margin="0,18,0,0" HorizontalAlignment="Center" FontSize="27"
                                       FontWeight="Bold" Foreground="{StaticResource TextBrush}" Text="Vvoidddd" />
                            <TextBlock Margin="0,7,0,22" TextAlignment="Center" TextWrapping="Wrap"
                                       Foreground="{StaticResource SecondaryBrush}"
                                       Text="Developer and maintainer of VoidLaunch." />
                            <WrapPanel HorizontalAlignment="Center">
                                <Button Margin="0,0,8,8" Content="Open developer GitHub" Click="OpenDeveloperGitHub_Click"
                                        Style="{StaticResource PrimaryButton}" />
                                <Button Margin="0,0,0,8" Content="View source on GitHub" Click="OpenRepository_Click"
                                        Style="{StaticResource SecondaryButton}" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ABOUT / HEALTH -->
                <Grid x:Name="AboutPage" Grid.Column="1" Margin="28" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="55" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Button HorizontalAlignment="Left" Content="←  Library" Click="BackToLibrary_Click"
                                Style="{StaticResource SecondaryButton}" />
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="25"
                                   FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Text="About &amp; Health" />
                    </Grid>
                    <ScrollViewer Grid.Row="1" Margin="0,8,0,0" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,0,12,0">
                            <Border Style="{StaticResource InfoCard}" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Text="VoidLaunch" />
                                        <TextBlock x:Name="AboutVersionText" Margin="0,5,0,0" Foreground="{StaticResource SecondaryBrush}" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Padding="12,7" Background="{StaticResource CardHoverBrush}" CornerRadius="12">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="9" Height="9" Margin="0,0,7,0" Fill="{StaticResource AccentBrush}" />
                                            <TextBlock x:Name="AboutHealthText" Foreground="{StaticResource TextBrush}" Text="Healthy" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource InfoCard}" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Text="Application health" />
                                    <TextBlock x:Name="AboutGameCountText" Margin="0,10,0,0" TextWrapping="Wrap" Foreground="{StaticResource SecondaryBrush}" />
                                    <TextBlock x:Name="AboutInstallPathText" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{StaticResource SecondaryBrush}" />
                                    <TextBlock x:Name="AboutDataPathText" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{StaticResource SecondaryBrush}" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource InfoCard}">
                                <StackPanel>
                                    <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Text="Updates" />
                                    <TextBlock x:Name="AboutUpdateSourceText" Margin="0,7,0,0" TextWrapping="Wrap" Foreground="{StaticResource SecondaryBrush}" />
                                    <TextBlock x:Name="AboutUpdateStatusText" Margin="0,7,0,0" TextWrapping="Wrap" Foreground="{StaticResource SecondaryBrush}" />
                                    <ProgressBar x:Name="UpdateProgressBar" Height="7" Margin="0,12,0,0" Minimum="0" Maximum="100"
                                                 Visibility="Collapsed" Style="{StaticResource VoidProgressBar}" />
                                    <WrapPanel Margin="0,14,0,0">
                                        <Button x:Name="CheckUpdatesButton" Margin="0,0,8,8" Content="Check for updates"
                                                Click="CheckUpdates_Click" Style="{StaticResource SecondaryButton}" />
                                        <Button x:Name="UpdateNowButton" Margin="0,0,8,8" Content="Download and restart"
                                                Click="UpdateNow_Click" Style="{StaticResource PrimaryButton}" Visibility="Collapsed" />
                                        <Button Margin="0,0,8,8" Content="Open releases" Click="OpenReleases_Click"
                                                Style="{StaticResource SecondaryButton}" />
                                        <Button Margin="0,0,0,8" Content="View source" Click="OpenRepository_Click"
                                                Style="{StaticResource SecondaryButton}" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- PRIVACY -->
                <Grid x:Name="PrivacyPage" Grid.Column="1" Margin="28" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="55" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Button HorizontalAlignment="Left" Content="←  Library" Click="BackToLibrary_Click"
                                Style="{StaticResource SecondaryButton}" />
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="25"
                                   FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Text="Privacy &amp; Transparency" />
                    </Grid>
                    <ScrollViewer Grid.Row="1" Margin="0,8,0,0" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,0,12,0">
                            <Border Style="{StaticResource InfoCard}" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Text="Nothing hidden" />
                                    <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" LineHeight="22"
                                               Foreground="{StaticResource SecondaryBrush}"
                                               Text="VoidLaunch has no analytics, advertisements, accounts, tracking SDKs, cryptocurrency miners, bundled installers, or hidden telemetry. It does not upload your game library or personal files." />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource InfoCard}" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Text="What stays on your PC" />
                                    <TextBlock Margin="0,9,0,0" TextWrapping="Wrap" LineHeight="21"
                                               Foreground="{StaticResource SecondaryBrush}"
                                               Text="Your selected game folders, executable choices, favorites, play history, and theme preferences are stored locally in your VoidLaunch application-data folder." />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource InfoCard}" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Text="Network access" />
                                    <TextBlock Margin="0,9,0,0" TextWrapping="Wrap" LineHeight="21"
                                               Foreground="{StaticResource SecondaryBrush}"
                                               Text="The launcher contacts GitHub's public Releases API to check for updates. Updates are downloaded only from the Vvoidddd/VoidLaunch GitHub release and are verified against GitHub's published SHA-256 digest before installation." />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource InfoCard}">
                                <StackPanel>
                                    <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Text="Source available" />
                                    <TextBlock Margin="0,9,0,14" TextWrapping="Wrap" LineHeight="21"
                                               Foreground="{StaticResource SecondaryBrush}"
                                               Text="The complete source code is public so anyone can inspect how scanning, launching, storage, themes, and updates work." />
                                    <Button HorizontalAlignment="Left" Content="Inspect the source on GitHub" Click="OpenRepository_Click"
                                            Style="{StaticResource PrimaryButton}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

            </Grid>

        </Grid>

    </Border>

</Window>
