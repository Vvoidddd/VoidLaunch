                                                   FontSize="31" FontWeight="Bold"
                                                   Foreground="{DynamicResource AccentTextBrush}" Text="◎" />
                                    </Border>

                                    <TextBlock Margin="0,20,0,0" HorizontalAlignment="Center" FontSize="25"
                                               FontWeight="Bold" Foreground="{DynamicResource TextBrush}"
                                               Text="VoidLaunch on the web" />
                                    <TextBlock Margin="0,10,0,0" TextAlignment="Center" TextWrapping="Wrap"
                                               LineHeight="22" Foreground="{DynamicResource SecondaryBrush}"
                                               Text="I plan on getting a domain with VoidLaunch in the name, but I have not decided whether it should be .xyz, .lol, or something else yet." />

                                    <WrapPanel Margin="0,20,0,20" HorizontalAlignment="Center">
                                        <Border Margin="4" Padding="14,8" Background="{DynamicResource CardHoverBrush}"
                                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12">
                                            <TextBlock FontSize="15" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource AccentBrush}" Text=".xyz" />
                                        </Border>
                                        <Border Margin="4" Padding="14,8" Background="{DynamicResource CardHoverBrush}"
                                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12">
                                            <TextBlock FontSize="15" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource AccentBrush}" Text=".lol" />
                                        </Border>
                                        <Border Margin="4" Padding="14,8" Background="{DynamicResource CardHoverBrush}"
                                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12">
                                            <TextBlock FontSize="15" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource AccentBrush}" Text="maybe another one" />
                                        </Border>
                                    </WrapPanel>

                                    <TextBlock TextAlignment="Center" TextWrapping="Wrap" LineHeight="21"
                                               Foreground="{DynamicResource SecondaryBrush}"
                                               Text="The future site will become the main place for downloads and other VoidLaunch stuff. Until a domain is announced here and on the official GitHub repository, only trust downloads from GitHub Releases." />
                                    <Button Margin="0,20,0,0" HorizontalAlignment="Center"
                                            Content="Open current GitHub downloads" Click="OpenReleases_Click"
                                            Style="{StaticResource PrimaryButton}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- PRIVACY -->
                <Grid x:Name="PrivacyPage" Grid.Column="1" Margin="28" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="55" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Button HorizontalAlignment="Left" Content="←  Library" Click="BackToLibrary_Click"
                                Style="{StaticResource SecondaryButton}" />
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="25"
                                   FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Text="Privacy &amp; Transparency" />
                    </Grid>
                    <ScrollViewer Grid.Row="1" Margin="0,8,0,0" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,0,12,0">
                            <Border Style="{StaticResource InfoCard}" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" Text="Nothing hidden" />
                                    <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" LineHeight="22"
                                               Foreground="{DynamicResource SecondaryBrush}"
                                               Text="VoidLaunch has no analytics, advertisements, accounts, tracking SDKs, cryptocurrency miners, bundled installers, or hidden telemetry. It does not upload your game library or personal files." />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource InfoCard}" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Text="What stays on your PC" />
                                    <TextBlock Margin="0,9,0,0" TextWrapping="Wrap" LineHeight="21"
                                               Foreground="{DynamicResource SecondaryBrush}"
                                               Text="Your selected game folders, executable choices, launch profiles, favorites, play history, logs, custom covers, and theme preferences are stored locally. By default they use your VoidLaunch application-data folder; portable mode keeps them beside the EXE." />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource InfoCard}" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Text="Network access" />
                                    <TextBlock Margin="0,9,0,0" TextWrapping="Wrap" LineHeight="21"
                                               Foreground="{DynamicResource SecondaryBrush}"
                                               Text="The launcher contacts GitHub's public Releases API to check for updates. Updates are downloaded only from the Vvoidddd/VoidLaunch GitHub release and are verified against GitHub's published SHA-256 digest before installation." />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource InfoCard}">
                                <StackPanel>
                                    <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Text="Source available" />
                                    <TextBlock Margin="0,9,0,14" TextWrapping="Wrap" LineHeight="21"
                                               Foreground="{DynamicResource SecondaryBrush}"
                                               Text="The complete source code is public so anyone can inspect how scanning, launching, storage, themes, and updates work." />
                                    <Button HorizontalAlignment="Left" Content="Inspect the source on GitHub" Click="OpenRepository_Click"
                                            Style="{StaticResource PrimaryButton}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

            </Grid>

        </Grid>

    </Border>

    <!-- In-app update notification. This stays sharp while MainWindowShell is blurred. -->
    <Border x:Name="UpdateNotificationOverlay" Panel.ZIndex="100"
            Background="{DynamicResource OverlayBrush}" CornerRadius="16"
            Visibility="Collapsed" Opacity="0">
        <Grid>
            <Border x:Name="UpdateNotificationCard" Width="470" Padding="28"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{DynamicResource CardBrush}"
                    BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                    CornerRadius="20" RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <ScaleTransform ScaleX="1" ScaleY="1" />
                </Border.RenderTransform>

                <StackPanel>
                    <Border Width="58" Height="58" HorizontalAlignment="Center"
                            Background="{DynamicResource AccentBrush}" CornerRadius="20">
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontSize="27" FontWeight="Bold"
                                   Foreground="{DynamicResource AccentTextBrush}" Text="↓" />
                    </Border>

                    <TextBlock Margin="0,18,0,0" HorizontalAlignment="Center"
                               FontSize="23" FontWeight="Bold"
                               Foreground="{DynamicResource TextBrush}"
                               Text="A VoidLaunch update is ready" />
                    <TextBlock x:Name="UpdateNotificationVersionText" Margin="0,8,0,0"
                               HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                               Foreground="{DynamicResource AccentBrush}" />
                    <TextBlock Margin="0,13,0,0" TextAlignment="Center" TextWrapping="Wrap"
                               LineHeight="21" Foreground="{DynamicResource SecondaryBrush}"
                                               Text="The update comes from the official GitHub release and will be SHA-256 verified. The old EXE is replaced by the new one at the exact same name and location, then VoidLaunch restarts." />

                    <ProgressBar x:Name="UpdateNotificationProgressBar" Height="7" Margin="0,18,0,0"
                                 Minimum="0" Maximum="100" Visibility="Collapsed"
                                 Style="{StaticResource VoidProgressBar}" />
                    <TextBlock x:Name="UpdateNotificationStatusText" Margin="0,9,0,0"
                               HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                               Foreground="{DynamicResource SecondaryBrush}" />

                    <Grid Margin="0,22,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="UpdateNotificationLaterButton" Grid.Column="0"
                                Content="Later" Click="UpdateNotificationLater_Click"
                                Style="{StaticResource SecondaryButton}" />
                        <Button x:Name="UpdateNotificationNowButton" Grid.Column="2"
                                Content="Update now" Click="UpdateNotificationNow_Click"
                                Style="{StaticResource PrimaryButton}" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Border>

    <!-- Crash follow-up. The complete persisted log can be opened or copied. -->
    <Border x:Name="CrashNotificationOverlay" Panel.ZIndex="110"
            Background="{DynamicResource OverlayBrush}" CornerRadius="16"
            Visibility="Collapsed" Opacity="0">
        <Grid>
            <Border Width="500" Padding="28" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{DynamicResource CardBrush}"
                    BorderBrush="{DynamicResource ErrorBrush}" BorderThickness="1"
                    CornerRadius="20">
                <StackPanel>
                    <Border Width="58" Height="58" HorizontalAlignment="Center"
                            Background="{DynamicResource ErrorBrush}" CornerRadius="20">
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontSize="26" FontWeight="Bold"
                                   Foreground="{DynamicResource AccentTextBrush}" Text="!" />
                    </Border>
                    <TextBlock x:Name="CrashNotificationTitleText" Margin="0,18,0,0"
                               HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                               FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" />
                    <TextBlock x:Name="CrashNotificationDetailsText" Margin="0,9,0,0"
                               HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                               Foreground="{DynamicResource ErrorBrush}" />
                    <TextBlock Margin="0,13,0,0" TextAlignment="Center" TextWrapping="Wrap"
                               LineHeight="21" Foreground="{DynamicResource SecondaryBrush}"
                               Text="VoidLaunch saved the session log locally. You can open it for troubleshooting or copy everything before dismissing this message." />
                    <WrapPanel Margin="0,22,0,0" HorizontalAlignment="Center">
                        <Button Margin="0,0,8,0" Content="Copy details" Click="CopyCrashDetails_Click"
                                Style="{StaticResource SecondaryButton}" />
                        <Button Margin="0,0,8,0" Content="Open log" Click="OpenCrashLog_Click"
                                Style="{StaticResource PrimaryButton}" />
                        <Button Content="Dismiss" Click="DismissCrashNotification_Click"
                                Style="{StaticResource SecondaryButton}" />
                    </WrapPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Border>

    </Grid>

</Window>
